{
  "openapi": "3.0.3",
  "info": {
    "title": "VIRPIL DCS LUA proxy (backend-proxy)",
    "version": "lua-proxy-api-catalog.v1",
    "description": "Plain HTTP/1.1 API for DCS mission LUA (no TLS in socket.http).\n\nHTTP/1.1 plain (no TLS in DCS LUA)\n\nSource: lua-proxy-api-catalog.json — regenerate with `make cms-ai-lua-proxy-catalog`."
  },
  "servers": [
    {
      "url": "http://proxy.vpc.local:4006",
      "description": "Local / dev (typical)"
    },
    {
      "url": "http://localhost:4006",
      "description": "Direct port"
    }
  ],
  "tags": [
    {
      "name": "proxy",
      "description": "DCS server-scoped read API"
    }
  ],
  "components": {
    "securitySchemes": {
      "DcsServer": {
        "type": "apiKey",
        "in": "header",
        "name": "X-DCS-SERVER",
        "description": "Base64-encoded server identifier (must match active servers.identifier in DB)"
      },
      "DcsUcid": {
        "type": "apiKey",
        "in": "header",
        "name": "X-DCS-UCID",
        "description": "Base64-encoded pilot UCID; used by some legacy rights logic (see /rights/list)"
      }
    },
